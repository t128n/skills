{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Skills Discovery index v0.2.0 (local mirror)",
  "description": "Mirror of the index format in the Agent Skills Discovery RFC v0.2.0 (https://github.com/cloudflare/agent-skills-discovery-rfc). The RFC publishes no schema file, and the $schema URI it names does not resolve, so this file is written from the RFC text.",
  "type": "object",
  "properties": {
    "$schema": { "const": "https://schemas.agentskills.io/discovery/0.2.0/schema.json" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "required": ["$schema", "skills"],
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": { "enum": ["skill-md", "archive"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "url": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["name", "type", "description", "url", "digest"]
    }
  }
}
